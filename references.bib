  urldate = {2023-04-12},
  abstract = {I give a simple construction of the Coulomb branches \$\{\textbackslash mathscr\{C\}\{3,4\}(G;E)\}\$ of gauge theory in three and four dimensions, defined by H. Nakajima \textbackslash [Adv. Theor. Math. Phys. 20 (2016)] and A. Braverman, M. Finkelberg and H. Nakajima \textbackslash [Adv. Theor. Math. Phys. 22 (2018)] for a compact Lie group \$G\$ and a polarizable quaternionic representation \$E\$. The manifolds \$\{\textbackslash mathscr\{C\}(G;\textbackslash mathbf\{0\})\}\$ are abelian group schemes over the bases of regular adjoint \$\{G\textbackslash mathbb\{C\}\}\$-orbits, respectively conjugacy classes, and \$\{\textbackslash mathscr\{C\}(G;E)\}\$ is glued together over the base from two copies of \$\{\textbackslash mathscr\{C\}(G;\textbackslash mathbf\{0\})\}\$ shifted by a rational Lagrangian section \$\{\textbackslash varepsilon\textbackslash\_V\}\$, representing the Euler class of the index bundle of a polarization \$\{V\}\$ of \$\{E\}\$. Extending the interpretation of \$\{\textbackslash mathscr\{C\}\textbackslash\_3(G;\textbackslash mathbf\{0\})\}\$ as ``classifying space'' for topological 2D gauge theories, I characterize functions on \$\{\textbackslash mathscr\{C\}\textbackslash\_3(G;E)\}\$ as operators on the equivariant quantum cohomologies of \$\{M\textbackslash times V\}\$, for compact symplectic \$\{G\}\$-manifolds \$\{M\}\$. The non-commutative version has a similar description in terms of the \$\{\textbackslash Gamma\}\$-class of \$\{V\}\$.},
  langid = {english},
