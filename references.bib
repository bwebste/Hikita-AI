}

@online{weekesGeneratorsCoulomb2019,
  title = {Generators for {{Coulomb}} branches of quiver gauge theories},
  author = {Weekes, Alex},
  date = {2019-05-14},
  eprint = {1903.07734},
  eprinttype = {arXiv},
  eprintclass = {math-ph},
  doi = {10.48550/arXiv.1903.07734},
  url = {http://arxiv.org/abs/1903.07734},
  urldate = {2023-06-11},
  abstract = {We study the Coulomb branches of \$3d\$ \$\textbackslash mathcal\{N\}=4\$ quiver gauge theories, focusing on the generators for their quantized coordinate rings. We show that there is a surjective map from a shifted Yangian onto the quantized Coulomb branch, once the deformation parameter is set to \$\textbackslash hbar =1\$. In finite ADE type, this extends to a surjection over \$\textbackslash mathbb\{C\}[\textbackslash hbar]\$. We also show that these algebras are generated by the dressed minuscule monopole operators, for an arbitrary quiver (this is similar to the proof of Theorem 4.29 in arXiv:1811.12137). Finally, we describe how the KLR Yangian algebra from arXiv:1806.07519 is related to Webster's extended BFN category. This paper provides proofs for two results which were announced in arXiv:1806.07519.},
  pubstate = {prepublished},
  keywords = {Mathematical Physics,Mathematics - Quantum Algebra,Mathematics - Representation Theory,Mathematics - Rings and Algebras},
  file = {/Users/benwebster/Zotero/storage/XWDUU3C4/Weekes - 2019 - Generators for Coulomb branches of quiver gauge th.pdf;/Users/benwebster/Zotero/storage/RJRV95ZJ/1903.html}
}

